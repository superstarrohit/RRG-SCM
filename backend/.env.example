# Copy to .env and adjust. All values have sensible defaults.

# Application database (where ingested dumps are staged and analysed).
# Default: local SQLite file. Point to Postgres for a shared deployment, e.g.
# APP_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/rrg_scm
APP_DATABASE_URL=sqlite:///./data/rrg_scm.db

# CORS origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Directory for uploaded files.
UPLOAD_DIR=./uploads

# Default "as of" date used by analytics when a dump has no snapshot date.
# Leave blank to use today's date.
DEFAULT_AS_OF_DATE=
